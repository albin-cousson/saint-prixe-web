---
import { urlFor } from '../../lib/sanity/image';

interface Props {
  groomPhoto?: any;
  bridePhoto?: any;
  groomName?: string;
  brideName?: string;
  size?: 'card' | 'hero';
}
const { groomPhoto, bridePhoto, groomName, brideName, size = 'card' } = Astro.props;

const isHero = size === 'hero';
// flex-1 + min-w-0 lets each photo shrink to fit whatever space is actually available
// (never wider than its card, on any screen). The hero variant caps how big it gets on
// larger screens; the card variant has no cap so the photos fill the card edge to edge.
const photoClass = isHero ? 'max-w-32 sm:max-w-40 md:max-w-48' : '';
const ampersandClass = isHero ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl';
const imgWidth = isHero ? 600 : 400;
const imgHeight = isHero ? 450 : 300;
const PhotoTag = isHero ? 'a' : 'div';
---

<div class="flex items-center justify-center gap-3 sm:gap-4">
  <PhotoTag
    href={isHero && groomPhoto ? urlFor(groomPhoto)?.width(1600).url() : undefined}
    data-lightbox={isHero && groomPhoto ? urlFor(groomPhoto)?.width(1600).url() : undefined}
    data-lightbox-alt={isHero && groomPhoto ? groomName : undefined}
    class:list={[photoClass, 'flex-1 min-w-0 aspect-[4/3] overflow-hidden bg-placeholder shadow-[0_8px_20px_rgba(0,0,0,0.16)] block']}
  >
    {groomPhoto && (
      <img
        src={urlFor(groomPhoto)?.width(imgWidth).height(imgHeight).url()}
        width={imgWidth}
        height={imgHeight}
        alt={groomName || 'Chien'}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
  </PhotoTag>
  <span class:list={['shrink-0 font-display italic text-gold-text', ampersandClass]} aria-hidden="true">&amp;</span>
  <PhotoTag
    href={isHero && bridePhoto ? urlFor(bridePhoto)?.width(1600).url() : undefined}
    data-lightbox={isHero && bridePhoto ? urlFor(bridePhoto)?.width(1600).url() : undefined}
    data-lightbox-alt={isHero && bridePhoto ? brideName : undefined}
    class:list={[photoClass, 'flex-1 min-w-0 aspect-[4/3] overflow-hidden bg-placeholder shadow-[0_8px_20px_rgba(0,0,0,0.16)] block']}
  >
    {bridePhoto && (
      <img
        src={urlFor(bridePhoto)?.width(imgWidth).height(imgHeight).url()}
        width={imgWidth}
        height={imgHeight}
        alt={brideName || 'Chienne'}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
  </PhotoTag>
</div>
