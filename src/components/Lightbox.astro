---
---

<div
  id="lightbox"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-ink/95 p-4 md:p-10 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Photo en grand"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Fermer"
    class="absolute top-4 right-4 md:top-6 md:right-6 w-10 h-10 flex items-center justify-center text-cream/80 hover:text-cream transition-colors"
  >
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>
  <div
    id="lightbox-spinner"
    class="absolute w-10 h-10 rounded-full border-2 border-cream/30 border-t-cream animate-spin"
  ></div>
  <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain opacity-0 transition-opacity duration-200" />
</div>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const spinner = document.getElementById('lightbox-spinner');
  const closeBtn = document.getElementById('lightbox-close');
  const preloaded = new Set<string>();

  function preload(src: string) {
    if (!src || preloaded.has(src)) return;
    preloaded.add(src);
    const img = new Image();
    img.src = src;
  }

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lightboxImg) return;
    const showImage = () => {
      lightboxImg.classList.remove('opacity-0');
      spinner?.classList.add('opacity-0');
    };
    lightboxImg.classList.add('opacity-0');
    spinner?.classList.remove('opacity-0');
    lightboxImg.onload = showImage;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    if (lightboxImg.complete && lightboxImg.currentSrc) showImage();
    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    document.documentElement.classList.add('overflow-hidden');
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    document.documentElement.classList.remove('overflow-hidden');
    lightboxImg.src = '';
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement)?.closest('[data-lightbox]');
    if (!el) return;
    e.preventDefault();
    const src = el.getAttribute('data-lightbox') || '';
    const alt = el.getAttribute('data-lightbox-alt') || '';
    openLightbox(src, alt);
  });

  document.addEventListener('mouseenter', (e) => {
    const el = (e.target as HTMLElement)?.closest?.('[data-lightbox]');
    if (el) preload(el.getAttribute('data-lightbox') || '');
  }, true);
  document.addEventListener('touchstart', (e) => {
    const el = (e.target as HTMLElement)?.closest('[data-lightbox]');
    if (el) preload(el.getAttribute('data-lightbox') || '');
  }, { passive: true });

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
