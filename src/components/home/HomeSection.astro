---
import Flourish from '../Flourish.astro';
import MariageCard from '../mariages/MariageCard.astro';
import DogCard from '../dogs/DogCard.astro';
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';

interface Props {
  section: any;
  index: number;
  mariages: any[];
  recentPosts: any[];
  males: any[];
  femelles: any[];
}

const { section, index, mariages, recentPosts, males, femelles } = Astro.props;

const shownMariages = mariages.slice(0, section.limit || 3);
const dogsList = section._type === 'malesSection' ? males : section._type === 'femellesSection' ? femelles : [];
const dogsHeadingDefault = section._type === 'malesSection' ? 'Nos Mâles' : 'Nos Femelles';
const dogsHrefDefault = section._type === 'malesSection' ? '/nos-males' : '/nos-femelles';

// Sections alternate cream / anthracite (ink) backgrounds automatically, cream first.
const isAlt = index % 2 === 1;
const bgClass = isAlt ? 'bg-ink text-cream' : 'bg-cream text-ink';
const mutedClass = isAlt ? 'text-cream/80' : 'text-muted';
const linkClass = isAlt
  ? 'font-semibold text-gold hover:text-cream transition-colors'
  : 'font-semibold text-gold-text hover:text-gold-deep transition-colors';
const outlineBtnClass = isAlt
  ? 'inline-block border border-cream/40 px-6 py-2.5 text-sm font-semibold hover:bg-cream hover:text-ink transition-colors'
  : 'inline-block border border-ink px-6 py-2.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors';
---

{section._type === 'pageSection' && (
  <section class:list={[bgClass, 'px-6 lg:px-10 py-16 md:py-20 text-center']}>
    <div class="max-w-2xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-3 uppercase">{section.heading}</h2>
      <Flourish class="mx-auto mb-6" />
      <p class:list={[mutedClass, 'leading-relaxed']}>
        {section.body?.map((b: any) => b.children?.map((c: any) => c.text).join('')).join(' ')}
      </p>
      {section.ctaHref && (
        <a href={section.ctaHref} class:list={['inline-block mt-6 text-sm', linkClass]}>
          {section.ctaLabel || 'En savoir plus'} ›
        </a>
      )}
    </div>
  </section>
)}

{section._type === 'mariagesSection' && mariages.length > 0 && (
  <section class:list={[bgClass, 'px-6 lg:px-10 py-16 md:py-20']}>
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">{section.heading || 'Nos Portées'}</h2>
      <Flourish class="mx-auto mb-12" />
      <div
        class:list={[
          'grid gap-8',
          shownMariages.length === 1 && 'grid-cols-1 max-w-md mx-auto',
          shownMariages.length === 2 && 'grid-cols-1 sm:grid-cols-2',
          shownMariages.length >= 3 && 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
        ]}
      >
        {shownMariages.map((m: any) => (
          <MariageCard
            slug={m.slug?.current}
            dogGroomName={m.dogGroomName}
            dogGroomPhoto={m.dogGroomPhoto}
            dogBrideName={m.dogBrideName}
            dogBridePhoto={m.dogBridePhoto}
            description={m.description}
            litterDate={m.litterDate}
            puppies={m.puppies || []}
          />
        ))}
      </div>
      <p class="text-center mt-10">
        <a href={section.ctaHref || '/nos-portees'} class="inline-block bg-gold hover:brightness-95 text-ink font-semibold px-7 py-3.5 transition">
          {section.ctaLabel || 'Voir toutes nos portées'} ›
        </a>
      </p>
    </div>
  </section>
)}

{section._type === 'actualitesSection' && recentPosts.length > 0 && (
  <section class:list={[bgClass, 'px-6 lg:px-10 py-16 md:py-20']}>
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">{section.heading || 'Actualités'}</h2>
      <Flourish class="mx-auto mb-12" />
      <div class="grid gap-8 sm:grid-cols-3">
        {recentPosts.slice(0, section.limit || 3).map((p: any) => (
          <a href={`/actualites/${p.slug.current}`} class="group block bg-white border border-border overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-placeholder">
              {p.coverImage && (
                <img
                  src={urlFor(p.coverImage)?.width(500).height(375).url()}
                  alt={p.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              )}
            </div>
            <div class="p-5">
              <h3 class="font-display font-bold text-base mb-1 text-ink">{p.title}</h3>
              {p.publishedAt && <p class="text-xs text-muted-2">{formatDateFr(p.publishedAt)}</p>}
            </div>
          </a>
        ))}
      </div>
      <p class="text-center mt-10">
        <a href={section.ctaHref || '/actualites'} class:list={outlineBtnClass}>
          {section.ctaLabel || 'Toutes les actualités'}
        </a>
      </p>
    </div>
  </section>
)}

{(section._type === 'malesSection' || section._type === 'femellesSection') && dogsList.length > 0 && (
  <section class:list={[bgClass, 'px-6 lg:px-10 py-16 md:py-20']}>
    <div class="max-w-7xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">{section.heading || dogsHeadingDefault}</h2>
      <Flourish class="mx-auto mb-12" />
      <div class="grid gap-8 sm:grid-cols-3 mb-8">
        {dogsList.slice(0, section.limit || 2).map((d: any) => (
          <DogCard name={d.name} photo={d.photo} birthDate={d.birthDate} deathDate={d.deathDate} sire={d.sire} dam={d.dam} href={`/nos-chiens/${d.slug?.current}`} />
        ))}
      </div>
      <p class="text-center">
        <a href={section.ctaHref || dogsHrefDefault} class:list={outlineBtnClass}>
          {section.ctaLabel || 'Tous les découvrir'}
        </a>
      </p>
    </div>
  </section>
)}
