---
import Layout from '../../layouts/Layout.astro';
import Flourish from '../../components/Flourish.astro';
import Lightbox from '../../components/Lightbox.astro';
import PostCard from '../../components/actualites/PostCard.astro';
import { PortableText } from 'astro-portabletext';
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';
import { sanityClient } from 'sanity:client';
import { BLOG_POST_SLUGS_QUERY, BLOG_POST_BY_SLUG_QUERY, BLOG_POSTS_QUERY, DOG_SLUGS_QUERY } from '../../lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(BLOG_POST_SLUGS_QUERY);
  return slugs.map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(BLOG_POST_BY_SLUG_QUERY, { slug });
if (!post) return Astro.redirect('/actualites');

const coverUrl = post.coverImage ? urlFor(post.coverImage)?.width(1000).height(750).url() : undefined;

const allPosts = await sanityClient.fetch(BLOG_POSTS_QUERY);
const dogSlugs = new Set((await sanityClient.fetch(DOG_SLUGS_QUERY)).map((s: { slug: string }) => s.slug));
const relatedPosts = allPosts
  .filter((p: any) => p.slug.current !== slug && !dogSlugs.has(p.slug.current))
  .slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  ...(coverUrl && { image: coverUrl }),
  ...(post.publishedAt && { datePublished: post.publishedAt }),
  author: { '@type': 'Organization', name: 'De Saint Prixe' },
  publisher: { '@type': 'Organization', name: 'De Saint Prixe' },
};
---

<Layout
  title={post.title}
  description={post.excerpt || "Actualité de l'élevage De Saint Prixe."}
  image={coverUrl}
  type="article"
  footerBg="ink"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="bg-cream min-h-screen px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-2xl mx-auto bg-white border border-border shadow-[0_16px_40px_rgba(0,0,0,0.12)] overflow-hidden">
      {coverUrl && (
        <div class="aspect-[4/3] overflow-hidden bg-placeholder">
          <img src={coverUrl} alt={post.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="p-8 md:p-12">
        <a href="/actualites" class="inline-block mb-6 text-sm text-muted-2 hover:text-gold-text transition-colors">
          ‹ Toutes les actualités
        </a>

        {post.publishedAt && (
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-gold-text mb-3">
            {formatDateFr(post.publishedAt)}
          </p>
        )}

        <h1 class="font-display font-bold text-3xl md:text-4xl mb-4">{post.title}</h1>
        <Flourish width={90} height={12} class="mb-8" />

        <div class="prose-body prose-body--dropcap text-[15px] leading-relaxed text-muted">
          <PortableText value={post.body} />
        </div>

        {post.gallery && post.gallery.length > 0 && (
          <div class="mt-10">
            <h2 class="font-display font-bold text-lg mb-4">Galerie</h2>
            <div class="columns-2 sm:columns-3 gap-3 space-y-3">
              {post.gallery.map((item: any) =>
                item._type === 'file' ? (
                  item.url && (
                    <video src={item.url} controls preload="metadata" class="w-full block bg-ink" />
                  )
                ) : (
                  <a
                    href={urlFor(item)?.width(1600).url()}
                    data-lightbox={urlFor(item)?.width(1600).url()}
                    data-lightbox-alt={`Photo — ${post.title}`}
                    class="block bg-placeholder"
                  >
                    <img src={urlFor(item)?.width(600).url()} alt={`Photo — ${post.title}`} loading="lazy" class="w-full block" />
                  </a>
                ),
              )}
            </div>
          </div>
        )}
      </div>
    </div>

    {relatedPosts.length > 0 && (
      <div class="max-w-5xl mx-auto mt-16">
        <h2 class="font-display font-bold text-2xl text-center mb-3">Découvrez aussi</h2>
        <Flourish class="mx-auto mb-10" />
        <div class="grid gap-6 sm:grid-cols-3">
          {relatedPosts.map((p: any) => (
            <PostCard post={p} />
          ))}
        </div>
      </div>
    )}
  </article>
  <Lightbox />
</Layout>
