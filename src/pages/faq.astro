---
import Layout from '../layouts/Layout.astro';
import Flourish from '../components/Flourish.astro';
import RichText from '../components/RichText.astro';
import { sanityClient } from 'sanity:client';
import { FAQ_PAGE_QUERY } from '../lib/sanity/queries';
import { hasRichText, richTextToPlainText } from '../lib/sanity/richText';

const page = await sanityClient.fetch(FAQ_PAGE_QUERY);

const FALLBACK_FAQS = [
  {
    question: 'Comment réserver un chiot ?',
    answer:
      "Contactez-nous via le formulaire de la page Contact, par téléphone ou par e-mail, en précisant la portée qui vous intéresse (voir la page Nos Portées). Nous échangeons avec vous pour vous accompagner dans le choix du chiot le plus adapté à votre famille.",
  },
  {
    question: 'Les chiots sont-ils inscrits au LOF ?',
    answer:
      "Oui, tous nos chiots Bearded Collie sont inscrits au LOF (Livre des Origines Français), identifiés par puce électronique et vaccinés avant leur départ.",
  },
  {
    question: "Quel est le prix d'un chiot Bearded Collie ?",
    answer:
      "Le tarif dépend de la portée et vous est communiqué directement lors de votre prise de contact. N'hésitez pas à nous écrire pour connaître le tarif de la portée en cours ou à venir.",
  },
  {
    question: 'Que reçoit-on à la remise du chiot ?',
    answer:
      "Le chiot vous est remis identifié, vacciné, accompagné de son carnet de santé et de son certificat de naissance LOF.",
  },
  {
    question: 'Le Bearded Collie est-il adapté aux familles avec enfants ?',
    answer:
      "C'est une race réputée pour son bon caractère : vive, éveillée et sans agressivité selon son standard officiel. Bien socialisés dès la naissance comme le sont nos chiots, les Bearded Collies s'entendent généralement très bien avec les enfants.",
  },
  {
    question: 'Où se trouve l\'élevage et quelles sont vos prochaines portées ?',
    answer:
      "L'élevage est situé à Raedersheim, dans le Haut-Rhin (68), en Alsace. Retrouvez nos couples, nos portées en cours et nos prochaines naissances sur la page Nos Portées.",
  },
];

const faqs = page?.questions?.length > 0 ? page.questions : FALLBACK_FAQS;

// `answer` is a plain string for the hardcoded fallback and rich text once it comes from
// Sanity — the JSON-LD schema always needs plain text either way.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f: { question: string; answer: string | any[] }) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: richTextToPlainText(f.answer) },
  })),
};
---

<Layout
  title={page?.seoTitle || 'FAQ — Réserver un chiot Bearded Collie'}
  description={
    page?.seoDescription ||
    "Toutes les réponses à vos questions sur nos chiots Bearded Collie : réservation, LOF, prix, remise du chiot — élevage De Saint Prixe, en Alsace."
  }
  breadcrumbs={[{ name: 'FAQ', path: '/faq' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl text-center mb-3">
        {page?.title || 'Questions fréquentes'}
      </h1>
      <Flourish class="mx-auto mb-6" />
      <div class="text-center text-muted max-w-xl mx-auto mb-14">
        {hasRichText(page?.intro) ? (
          <RichText value={page.intro} />
        ) : (
          <p>Les réponses aux questions qu'on nous pose le plus souvent avant l'arrivée d'un chiot Bearded Collie.</p>
        )}
      </div>

      <div class="bg-white border border-border divide-y divide-border">
        {faqs.map((f: { question: string; answer: string | any[] }, i: number) => (
          <details class="faq-item group" name="faq" open={i === 0}>
            <summary class="flex items-baseline gap-4 md:gap-5 px-5 md:px-7 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none transition-colors hover:bg-cream/60 focus-visible:outline-none focus-visible:bg-cream/60 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-gold">
              <span class="font-display font-bold text-sm text-gold-text tabular-nums shrink-0 w-6" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="flex-1 font-display font-bold text-lg md:text-xl leading-snug">{f.question}</h2>
              <span
                class="faq-icon shrink-0 self-center w-7 h-7 flex items-center justify-center border border-gold text-gold-text text-lg leading-none transition-transform duration-300 group-open:rotate-45 motion-reduce:transition-none"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-5 md:px-7 pb-6 pl-[3.75rem] md:pl-[4.25rem] prose-body text-[15px] leading-relaxed text-muted">
              <RichText value={f.answer} />
            </div>
          </details>
        ))}
      </div>

      <div class="mt-12 bg-ink text-cream px-6 py-10 md:py-12 text-center">
        <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-gold mb-3">Une autre question ?</p>
        <p class="font-display font-bold text-xl md:text-2xl mb-6">Nous vous répondons avec plaisir.</p>
        <a
          href="/contact"
          class="inline-block bg-gold hover:brightness-95 text-ink font-semibold text-sm px-7 py-3.5 transition"
        >
          Contactez-nous ›
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Animate the native <details> panel (Chrome 131+ / Safari 26+); other browsers simply
   * open instantly, which is the accessible default. */
  .faq-item {
    interpolate-size: allow-keywords;
  }
  .faq-item::details-content {
    height: 0;
    overflow: hidden;
    transition:
      height 0.3s ease,
      content-visibility 0.3s allow-discrete;
  }
  .faq-item[open]::details-content {
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
