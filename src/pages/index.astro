---
import Layout from '../layouts/Layout.astro';
import HomeSection from '../components/home/HomeSection.astro';
import { urlFor } from '../lib/sanity/image';
import { sanityClient } from 'sanity:client';
import {
  HOME_PAGE_QUERY,
  BLOG_POSTS_QUERY,
  DOGS_BY_SEX_QUERY,
  MARIAGES_WITH_CHIOTS_QUERY,
  NOS_PORTEES_PAGE_QUERY,
} from '../lib/sanity/queries';

const home = await sanityClient.fetch(HOME_PAGE_QUERY);
const recentPosts = await sanityClient.fetch(BLOG_POSTS_QUERY);
const males = await sanityClient.fetch(DOGS_BY_SEX_QUERY, { sex: 'Mâle' });
const femelles = await sanityClient.fetch(DOGS_BY_SEX_QUERY, { sex: 'Femelle' });
const mariages = await sanityClient.fetch(MARIAGES_WITH_CHIOTS_QUERY);
// Only the card CTA label is needed here — the rest of nosPorteesPage belongs to /nos-portees.
const porteesPage = await sanityClient.fetch(NOS_PORTEES_PAGE_QUERY);
---

<Layout
  title={home?.seoTitle || 'Élevage Bearded Collie en Alsace — Chiots LOF disponibles'}
  description={home?.seoDescription || "Élevage familial De Saint Prixe, Bearded Collie en Alsace (Haut-Rhin, 68). Chiots LOF disponibles, pedigree soigné : découvrez nos chiens, nos portées et notre guide de la race."}
  image={home?.heroImage ? urlFor(home.heroImage)?.width(1200).height(630).url() : undefined}
  footerBg="ink"
>
  <section class="relative bg-ink text-cream overflow-hidden">
    {home?.heroImage && (
      <div class="absolute inset-0 lg:hidden">
        <img
          src={urlFor(home.heroImage)?.width(900).height(1100).url()}
          alt="Élevage De Saint Prixe — Bearded Collies en Alsace"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-ink/60"></div>
      </div>
    )}
    <div class="relative z-10 max-w-7xl mx-auto grid lg:grid-cols-2 items-center py-16 lg:py-0 min-h-[480px] lg:min-h-[560px]">
      <div class="text-center px-4 lg:px-8">
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl uppercase leading-[1.05] mb-6">
          {home?.heroHeadline || 'Découvrez notre élevage'}
        </h1>
        {home?.heroSubheadline && (
          <p class="text-lg md:text-xl text-cream/85 mb-8">{home.heroSubheadline}</p>
        )}
        <a
          href={home?.heroButtonHref || '/nos-portees'}
          class="inline-block bg-gradient-to-br from-[#e8c9a0] to-gold text-ink font-semibold px-7 py-3.5 hover:opacity-90 transition-opacity"
        >
          {home?.heroButtonLabel || 'Nos Portées'} ›
        </a>
      </div>
      {home?.heroImage && (
        <div class="hidden lg:block h-[560px]">
          <img
            src={urlFor(home.heroImage)?.width(900).height(1100).url()}
            alt="Élevage De Saint Prixe — Bearded Collies en Alsace"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      )}
    </div>
  </section>

  {home?.sections?.map((section: any, i: number) => (
    <HomeSection
      section={section}
      index={i}
      mariages={mariages}
      recentPosts={recentPosts}
      males={males}
      femelles={femelles}
      mariageCardCtaLabel={porteesPage?.cardCtaLabel}
    />
  ))}
</Layout>
