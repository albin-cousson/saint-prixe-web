---
import Layout from '../layouts/Layout.astro';
import Lightbox from '../components/Lightbox.astro';
import { urlFor } from '../lib/sanity/image';
import { sanityClient } from 'sanity:client';
import { PORTFOLIO_PAGE_QUERY } from '../lib/sanity/queries';

const page = await sanityClient.fetch(PORTFOLIO_PAGE_QUERY);
// Videos have no width metadata (that field only exists on image assets), so only apply the
// "broken/empty item" width filter to photos — real video items always pass through.
const images = (page?.images || []).filter((img: any) => img._type === 'file' || (img.width ?? 0) > 100);
---

<Layout
  title={page?.seoTitle || 'Portfolio photo — Élevage de Bearded Collie De Saint Prixe'}
  description={page?.seoDescription || 'Portfolio photo de nos Bearded Collies : chiens, chiots et moments de vie à l\'élevage De Saint Prixe, en Alsace.'}
  footerBg="ink"
>
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class:list={['font-display font-bold text-3xl md:text-4xl text-center', page?.intro ? 'mb-3' : 'mb-14']}>
        {page?.title || 'Portfolio'}
      </h1>
      {page?.intro && <p class="text-center text-muted max-w-2xl mx-auto mb-14">{page.intro}</p>}
      <div class="columns-2 sm:columns-3 lg:columns-4 gap-4 space-y-4">
        {images.map((img: any, i: number) =>
          img._type === 'file' ? (
            img.url && <video src={img.url} controls preload="metadata" class="w-full block bg-ink" />
          ) : (
            <a
              href={urlFor(img)?.width(1600).url()}
              data-lightbox={urlFor(img)?.width(1600).url()}
              data-lightbox-alt={`Portfolio De Saint Prixe — photo ${i + 1}`}
              class="block"
            >
              <img
                src={urlFor(img)?.width(600).url()}
                alt={`Portfolio De Saint Prixe — photo ${i + 1}`}
                loading="lazy"
                class="w-full block"
              />
            </a>
          ),
        )}
      </div>
    </div>
  </section>
  <Lightbox />
</Layout>
