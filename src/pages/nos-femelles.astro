---
import Layout from '../layouts/Layout.astro';
import DogCard from '../components/dogs/DogCard.astro';
import { sanityClient } from 'sanity:client';
import { DOGS_BY_SEX_QUERY, NOS_FEMELLES_PAGE_QUERY } from '../lib/sanity/queries';

const page = await sanityClient.fetch(NOS_FEMELLES_PAGE_QUERY);
const dogs = await sanityClient.fetch(DOGS_BY_SEX_QUERY, { sex: 'Femelle' });
---

<Layout
  title={page?.seoTitle || 'Femelles Bearded Collie — Élevage en Alsace'}
  description={page?.seoDescription || "Découvrez nos femelles Bearded Collie, élevage De Saint Prixe en Alsace (Haut-Rhin) : pedigree LOF, santé et caractère de la race."}
>
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class:list={['font-display font-bold text-3xl md:text-4xl text-center', page?.intro ? 'mb-3' : 'mb-14']}>
        {page?.title || 'Nos femelles Bearded Collies'}
      </h1>
      {page?.intro && <p class="text-center text-muted max-w-2xl mx-auto mb-14">{page.intro}</p>}
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {dogs.map((d: any) => (
          <DogCard
            name={d.name}
            photo={d.photo}
            birthDate={d.birthDate}
            deathDate={d.deathDate}
            sire={d.sire}
            dam={d.dam}
            href={d.slug?.current ? `/nos-chiens/${d.slug.current}` : undefined}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
