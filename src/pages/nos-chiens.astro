---
import Layout from '../layouts/Layout.astro';
import DogCard from '../components/dogs/DogCard.astro';
import RichText from '../components/RichText.astro';
import { sanityClient } from 'sanity:client';
import { DOGS_BY_SEX_QUERY, NOS_CHIENS_PAGE_QUERY } from '../lib/sanity/queries';
import { hasRichText } from '../lib/sanity/richText';

const page = await sanityClient.fetch(NOS_CHIENS_PAGE_QUERY);
const males = (await sanityClient.fetch(DOGS_BY_SEX_QUERY, { sex: 'Mâle' })).slice(0, 3);
const femelles = (await sanityClient.fetch(DOGS_BY_SEX_QUERY, { sex: 'Femelle' })).slice(0, 3);
---

<Layout
  title={page?.seoTitle || 'Nos Bearded Collies — Chiens de l\'élevage en Alsace'}
  description={page?.seoDescription || "Découvrez les Bearded Collies de l'élevage De Saint Prixe en Alsace (Haut-Rhin) : mâles, femelles, pedigree LOF et caractère de la race."}
  breadcrumbs={[{ name: 'Nos Chiens', path: '/nos-chiens' }]}
>
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl text-center mb-3">{page?.title || 'Nos Bearded Collies'}</h1>
      <div class="text-center text-muted max-w-2xl mx-auto mb-3">
        {hasRichText(page?.intro) ? (
          <RichText value={page.intro} />
        ) : (
          <p>Nos Bearded Collies sont au cœur de notre passion et de nos projets d'élevage, au sein de notre élevage familial en Alsace (Haut-Rhin).</p>
        )}
      </div>
      <p class="text-center mb-14">
        <a href="/guide-bearded-collie" class="text-sm text-gold-text font-semibold hover:text-gold-deep transition-colors">
          En savoir plus sur la race (origines, caractère, entretien) ›
        </a>
      </p>

      <div class="mb-16">
        <h2 class="font-display font-bold text-2xl text-center mb-8">Nos Mâles</h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 mb-8">
          {males.map((d: any) => (
            <DogCard name={d.name} photo={d.photo} birthDate={d.birthDate} deathDate={d.deathDate} sire={d.sire} dam={d.dam} href={`/nos-chiens/${d.slug?.current}`} />
          ))}
        </div>
        <p class="text-center">
          <a href="/nos-males" class="inline-block border border-ink px-6 py-2.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
            {page?.malesCtaLabel || 'Tous les découvrir'}
          </a>
        </p>
      </div>

      <div class="mb-16">
        <h2 class="font-display font-bold text-2xl text-center mb-8">Nos Femelles</h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 mb-8">
          {femelles.map((d: any) => (
            <DogCard name={d.name} photo={d.photo} birthDate={d.birthDate} deathDate={d.deathDate} sire={d.sire} dam={d.dam} href={`/nos-chiens/${d.slug?.current}`} />
          ))}
        </div>
        <p class="text-center">
          <a href="/nos-femelles" class="inline-block border border-ink px-6 py-2.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
            {page?.femellesCtaLabel || 'Toutes les découvrir'}
          </a>
        </p>
      </div>

      <div class="text-center">
        <h2 class="font-display font-bold text-2xl mb-4">Nos Portées</h2>
        <a href="/nos-portees" class="inline-block bg-gold hover:brightness-95 text-ink px-6 py-3 text-sm font-semibold transition">
          Découvrir nos portées ›
        </a>
      </div>
    </div>
  </section>
</Layout>
