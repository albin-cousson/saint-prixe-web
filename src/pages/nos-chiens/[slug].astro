---
import Layout from '../../layouts/Layout.astro';
import Flourish from '../../components/Flourish.astro';
import Lightbox from '../../components/Lightbox.astro';
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';
import { sanityClient } from 'sanity:client';
import { DOG_SLUGS_QUERY, DOG_BY_SLUG_QUERY } from '../../lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(DOG_SLUGS_QUERY);
  return slugs.map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const dog = await sanityClient.fetch(DOG_BY_SLUG_QUERY, { slug });
if (!dog) return Astro.redirect('/nos-chiens');

const stats = [
  dog.birthDate && {
    label: dog.deathDate ? 'Période de vie' : 'Né(e) le',
    value: dog.deathDate
      ? `${formatDateFr(dog.birthDate)} — ${formatDateFr(dog.deathDate)}`
      : formatDateFr(dog.birthDate),
  },
  dog.sire && { label: 'Père', value: dog.sire },
  dog.dam && { label: 'Mère', value: dog.dam },
].filter(Boolean) as { label: string; value: string }[];
---

<Layout
  title={`${dog.name} — Bearded Collie`}
  description={`${dog.name} — Bearded Collie, élevage De Saint Prixe.`}
  image={dog.photo ? urlFor(dog.photo)?.width(1200).height(630).url() : undefined}
  footerBg="ink"
>
  <article class="bg-cream min-h-screen px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-2xl mx-auto text-center">
      <a href="/nos-chiens" class="inline-block mb-6 text-sm text-muted-2 hover:text-gold-text transition-colors">
        ‹ Retour à nos chiens
      </a>

      <div class="relative aspect-[4/3] overflow-hidden bg-ink shadow-[0_16px_40px_rgba(0,0,0,0.16)] mb-8">
        {dog.photo && (
          <img
            src={urlFor(dog.photo)?.width(1200).height(900).url()}
            alt={dog.name}
            class="w-full h-full object-cover"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/5 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 px-6 md:px-10 pb-6 md:pb-8 text-center">
          <h1 class="font-display font-bold text-3xl md:text-5xl text-white mb-1">{dog.name}</h1>
          {dog.sex && (
            <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-gold">{dog.sex}</p>
          )}
        </div>
      </div>

      <div class="space-y-8">
        <Flourish width={90} height={12} class="mx-auto" />

        {dog.deathDate && (
          <div class="bg-ink text-cream border border-ink p-8 md:p-10 text-center">
            <span class="inline-block text-gold text-xl mb-3" aria-hidden="true">✦</span>
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-gold mb-2">
              En mémoire de {dog.name}
            </p>
            <p class="font-display font-bold text-base text-cream/85 mb-5">
              {dog.birthDate && `${formatDateFr(dog.birthDate)} — `}{formatDateFr(dog.deathDate)}
            </p>
            {dog.memorialText && (
              <p class="font-display italic text-lg leading-relaxed text-cream max-w-lg mx-auto">
                "{dog.memorialText}"
              </p>
            )}
            <Flourish width={70} height={10} class="mx-auto mt-6" />
          </div>
        )}

        {stats.length > 0 && (
          <div class="bg-white border border-border grid grid-cols-1 sm:grid-cols-3 divide-y divide-border sm:divide-y-0 sm:divide-x">
            {stats.map((s) => (
              <div class="px-6 py-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-muted-2 mb-1">{s.label}</p>
                <p class="font-display font-bold text-base">{s.value}</p>
              </div>
            ))}
          </div>
        )}

        {dog.pedigreeFile?.url && (
          <a
            href={`/.netlify/functions/pedigree?url=${encodeURIComponent(dog.pedigreeFile.url)}&filename=${encodeURIComponent(dog.pedigreeFile.filename)}`}
            download={dog.pedigreeFile.filename}
            class="group w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gold hover:brightness-95 text-ink px-7 py-3.5 text-sm font-semibold shadow-[0_8px_20px_rgba(0,0,0,0.12)] transition"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="transition-transform duration-300 group-hover:translate-y-0.5">
              <path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Télécharger le pedigree
          </a>
        )}

        {dog.titles && dog.titles.length > 0 && (
          <div class="bg-white border border-border p-8 md:p-10 text-left">
            <h2 class="font-display font-bold text-lg mb-4 text-center">Palmarès</h2>
            <ul class="text-sm text-muted space-y-2 max-w-md mx-auto">
              {dog.titles.map((t: string) => (
                <li class="flex gap-2">
                  <span class="text-gold-deep">✦</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {dog.gallery && dog.gallery.length > 0 && (
          <div class="columns-2 sm:columns-3 gap-3 space-y-3 text-left">
            {dog.gallery.map((item: any) =>
              item._type === 'file' ? (
                item.url && (
                  <video src={item.url} controls preload="metadata" class="w-full block bg-ink" />
                )
              ) : (
                <a
                  href={urlFor(item)?.width(1600).url()}
                  data-lightbox={urlFor(item)?.width(1600).url()}
                  data-lightbox-alt={`Photo de ${dog.name}`}
                  class="block bg-placeholder"
                >
                  <img src={urlFor(item)?.width(600).url()} alt={`Photo de ${dog.name}`} loading="lazy" class="w-full block" />
                </a>
              ),
            )}
          </div>
        )}
      </div>
    </div>
  </article>
  <Lightbox />
</Layout>
