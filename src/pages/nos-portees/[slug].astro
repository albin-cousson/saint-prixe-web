---
import Layout from '../../layouts/Layout.astro';
import Flourish from '../../components/Flourish.astro';
import Lightbox from '../../components/Lightbox.astro';
import MasonryGallery from '../../components/MasonryGallery.astro';
import CoupleMedallion from '../../components/mariages/CoupleMedallion.astro';
import PuppyCarousel from '../../components/mariages/PuppyCarousel';
import RichText from '../../components/RichText.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';
import { collectLitterMedia, seededShuffle } from '../../lib/litter';
import { MARIAGE_SLUGS_QUERY, MARIAGE_BY_SLUG_QUERY, NOS_PORTEES_PAGE_QUERY } from '../../lib/sanity/queries';
import { hasRichText, richTextToPlainText } from '../../lib/sanity/richText';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(MARIAGE_SLUGS_QUERY);
  return slugs.map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const mariage = await sanityClient.fetch(MARIAGE_BY_SLUG_QUERY, { slug });
const porteesPage = await sanityClient.fetch(NOS_PORTEES_PAGE_QUERY);

if (!mariage) return Astro.redirect('/nos-portees');

const puppies = (mariage.puppies || []) as any[];
const pairName = `${mariage.dogGroomName} & ${mariage.dogBrideName}`;
const litterIsFuture = mariage.litterDate ? new Date(mariage.litterDate).getTime() > Date.now() : null;
// "Portée entièrement placée" (Studio checkbox): the per-puppy cards give way to one album —
// the mariage's own gallery + every puppy's photos — shuffled so the litter reads as a whole.
const album = mariage.litterSold ? seededShuffle(collectLitterMedia(mariage, pairName), mariage._id) : [];
const showAlbum = album.length > 0;
---

<Layout
  title={`${mariage.dogGroomName} × ${mariage.dogBrideName} — Chiots Bearded Collie`}
  description={richTextToPlainText(mariage.description) || `Chiots Bearded Collie LOF de ${pairName} — élevage De Saint Prixe, en Alsace (Haut-Rhin).`}
  image={mariage.dogGroomPhoto ? urlFor(mariage.dogGroomPhoto)?.width(1200).height(630).url() : undefined}
  breadcrumbs={[
    { name: 'Nos Portées', path: '/nos-portees' },
    { name: pairName, path: `/nos-portees/${slug}` },
  ]}
>
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
      <div class="text-center">
        <a href="/nos-portees" class="inline-block mb-6 text-sm text-muted-2 hover:text-gold-text transition-colors">
          ‹ Retour à nos portées
        </a>
      </div>

      <div class="bg-white border border-border p-6 sm:p-10 md:p-12 text-center mb-16">
        <div class="mb-6">
          <CoupleMedallion
            groomPhoto={mariage.dogGroomPhoto}
            bridePhoto={mariage.dogBridePhoto}
            groomName={mariage.dogGroomName}
            brideName={mariage.dogBrideName}
            size="hero"
          />
        </div>

        <h1 class="font-display font-bold text-3xl md:text-4xl mb-1.5">
          {mariage.dogGroomName} &amp; {mariage.dogBrideName}
        </h1>
        <Flourish width={140} height={16} class="mx-auto mb-4" />

        {hasRichText(mariage.description) && (
          <div class="max-w-[60ch] mx-auto text-[15px] leading-relaxed text-muted mb-2">
            <RichText value={mariage.description} />
          </div>
        )}

        {mariage.litterDate && (
          <p class="text-sm text-muted-2 mt-3.5">
            🐾 {litterIsFuture ? 'Naissance des chiots prévue le' : 'Chiots nés le'} {formatDateFr(mariage.litterDate)}
          </p>
        )}
      </div>
    </div>

    <div class:list={['mx-auto', showAlbum ? 'max-w-7xl' : 'max-w-4xl']}>
      {showAlbum ? (
        <div class="text-center mb-10">
          <p class="inline-flex items-center gap-2 border border-gold text-gold-text text-[11px] font-semibold uppercase tracking-[0.2em] px-3.5 py-1.5 mb-5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Portée complète
          </p>
          <h2 class="font-display font-bold text-2xl md:text-3xl mb-3">
            Les chiots de {mariage.dogGroomName} &amp; {mariage.dogBrideName}
          </h2>
          <p class="text-[15px] leading-relaxed text-muted max-w-[52ch] mx-auto">
            {puppies.length > 1
              ? `Les ${puppies.length} chiots de cette portée ont tous rejoint leur nouvelle famille.`
              : 'Le chiot de cette portée a rejoint sa nouvelle famille.'}
            {' '}Retour en images sur leurs premières semaines à l'élevage.
          </p>
        </div>
      ) : (
        <h2 class="font-display font-bold text-2xl text-center mb-8">
          Les chiots de {mariage.dogGroomName} &amp; {mariage.dogBrideName}
        </h2>
      )}

      {showAlbum ? (
        <>
          <MasonryGallery items={album} altPrefix={`Chiots de ${pairName}`} />
          <div class="text-center mt-14">
            <p class="text-sm text-muted-2 mb-5">Vous souhaitez accueillir un chiot De Saint Prixe ?</p>
            <a
              href={`/contact?sujet=${encodeURIComponent(`la prochaine portée`)}`}
              class="inline-block bg-gold hover:brightness-95 text-ink font-semibold px-6 py-3 text-sm transition"
            >
              Être prévenu·e de la prochaine portée ›
            </a>
          </div>
        </>
      ) : puppies.length === 0 ? (
        <div class="text-center">
          <p class="text-muted-2 italic mb-6">
            {litterIsFuture === false
              ? `Les fiches des chiots de ${pairName} arrivent bientôt.`
              : `Les chiots de ${pairName} ne sont pas encore nés.`}
          </p>
          <a
            href={`/contact?sujet=${encodeURIComponent(`la portée de ${pairName}`)}`}
            class="inline-block bg-gold hover:brightness-95 text-ink font-semibold px-6 py-3 text-sm transition"
          >
            {porteesPage?.notifyCtaLabel || 'Être prévenu·e de la naissance'} ›
          </a>
        </div>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {puppies.map((p: any) => {
            const media = [
              p.photo && { type: 'image' as const, url: urlFor(p.photo)?.width(700).height(875).url() },
              ...(p.gallery || []).map((item: any) =>
                item._type === 'file'
                  ? item.url && { type: 'video' as const, url: item.url }
                  : { type: 'image' as const, url: urlFor(item)?.width(700).height(875).url() },
              ),
            ].filter((m): m is { type: 'image' | 'video'; url: string } => Boolean(m && m.url));
            return (
              <PuppyCarousel
                client:visible
                title={p.title}
                gender={p.gender}
                color={p.color}
                birthDate={p.birthDate}
                status={p.status}
                description={p.description}
                media={media}
                reserveLabel={porteesPage?.reserveCtaLabel}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>
  <Lightbox />
</Layout>
