---
import Layout from '../../layouts/Layout.astro';
import Flourish from '../../components/Flourish.astro';
import Lightbox from '../../components/Lightbox.astro';
import CoupleMedallion from '../../components/mariages/CoupleMedallion.astro';
import PuppyCarousel from '../../components/mariages/PuppyCarousel';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';
import { MARIAGE_SLUGS_QUERY, MARIAGE_BY_SLUG_QUERY } from '../../lib/sanity/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(MARIAGE_SLUGS_QUERY);
  return slugs.map((s: { slug: string }) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const mariage = await sanityClient.fetch(MARIAGE_BY_SLUG_QUERY, { slug });

if (!mariage) return Astro.redirect('/nos-portees');

const puppies = (mariage.puppies || []) as any[];
const pairName = `${mariage.dogGroomName} & ${mariage.dogBrideName}`;
const litterIsFuture = mariage.litterDate ? new Date(mariage.litterDate).getTime() > Date.now() : null;
---

<Layout
  title={`${mariage.dogGroomName} & ${mariage.dogBrideName}`}
  description={mariage.description || `Portée de Bearded Collies de ${pairName} — élevage De Saint Prixe, Alsace.`}
  image={mariage.dogGroomPhoto ? urlFor(mariage.dogGroomPhoto)?.width(1200).height(630).url() : undefined}
>
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
      <div class="text-center">
        <a href="/nos-portees" class="inline-block mb-6 text-sm text-muted-2 hover:text-gold-text transition-colors">
          ‹ Retour à nos portées
        </a>
      </div>

      <div class="bg-white border border-border p-6 sm:p-10 md:p-12 text-center mb-16">
        <div class="mb-6">
          <CoupleMedallion
            groomPhoto={mariage.dogGroomPhoto}
            bridePhoto={mariage.dogBridePhoto}
            groomName={mariage.dogGroomName}
            brideName={mariage.dogBrideName}
            size="hero"
          />
        </div>

        <h1 class="font-display font-bold text-3xl md:text-4xl mb-1.5">
          {mariage.dogGroomName} &amp; {mariage.dogBrideName}
        </h1>
        <Flourish width={140} height={16} class="mx-auto mb-4" />

        {mariage.description && (
          <p class="max-w-[60ch] mx-auto text-[15px] leading-relaxed text-muted mb-2">{mariage.description}</p>
        )}

        {mariage.litterDate && (
          <p class="text-sm text-muted-2 mt-3.5">
            🐾 {litterIsFuture ? 'Naissance des chiots prévue le' : 'Chiots nés le'} {formatDateFr(mariage.litterDate)}
          </p>
        )}
      </div>

      <h2 class="font-display font-bold text-2xl text-center mb-8">
        Les chiots de {mariage.dogGroomName} &amp; {mariage.dogBrideName}
      </h2>

      {puppies.length === 0 ? (
        <div class="text-center">
          <p class="text-muted-2 italic mb-6">
            {litterIsFuture === false
              ? `Les fiches des chiots de ${pairName} arrivent bientôt.`
              : `Les chiots de ${pairName} ne sont pas encore nés.`}
          </p>
          <a
            href={`/contact?sujet=${encodeURIComponent(`la portée de ${pairName}`)}`}
            class="inline-block bg-gold hover:brightness-95 text-ink font-semibold px-6 py-3 text-sm transition"
          >
            Être prévenu·e de la naissance ›
          </a>
        </div>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {puppies.map((p: any) => {
            const images = [p.photo, ...(p.gallery || [])]
              .filter(Boolean)
              .map((img: any) => urlFor(img)?.width(700).height(875).url())
              .filter(Boolean) as string[];
            return (
              <PuppyCarousel
                client:visible
                title={p.title}
                gender={p.gender}
                color={p.color}
                birthDate={p.birthDate}
                status={p.status}
                description={p.description}
                images={images}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>
  <Lightbox />
</Layout>
