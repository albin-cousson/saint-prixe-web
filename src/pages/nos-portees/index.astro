---
import Layout from '../../layouts/Layout.astro';
import MariageCard from '../../components/mariages/MariageCard.astro';
import RichText from '../../components/RichText.astro';
import { sanityClient } from 'sanity:client';
import { MARIAGES_WITH_CHIOTS_QUERY, NOS_PORTEES_PAGE_QUERY } from '../../lib/sanity/queries';
import { hasRichText, richTextToPlainText } from '../../lib/sanity/richText';

const page = await sanityClient.fetch(NOS_PORTEES_PAGE_QUERY);
const mariages = await sanityClient.fetch(MARIAGES_WITH_CHIOTS_QUERY);
---

<Layout
  title={page?.seoTitle || 'Chiots Bearded Collie disponibles — Nos Portées'}
  description={page?.seoDescription || "Chiots Bearded Collie LOF disponibles à l'élevage De Saint Prixe, en Alsace (Haut-Rhin). Découvrez nos couples, nos portées en cours et nos prochaines naissances."}
  breadcrumbs={[{ name: 'Nos Portées', path: '/nos-portees' }]}
>
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl text-center mb-3">{page?.title || 'Nos Portées de Bearded Collie'}</h1>
      <div class="text-center text-muted max-w-2xl mx-auto mb-14">
        {hasRichText(page?.intro) ? (
          <RichText value={page.intro} />
        ) : (
          <p>Découvrez nos couples et les chiots disponibles, portée par portée.</p>
        )}
      </div>

      {mariages.length === 0 ? (
        <p class="text-center text-muted-2 italic py-10">
          Aucun mariage à afficher pour le moment. Revenez bientôt.
        </p>
      ) : (
        <div
          class:list={[
            'grid gap-10',
            mariages.length === 1 && 'grid-cols-1 max-w-md mx-auto',
            mariages.length === 2 && 'grid-cols-1 sm:grid-cols-2',
            mariages.length >= 3 && 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {mariages.map((m: any) => (
            <MariageCard
              id={m._id}
              slug={m.slug?.current}
              dogGroomName={m.dogGroomName}
              dogGroomPhoto={m.dogGroomPhoto}
              dogBrideName={m.dogBrideName}
              dogBridePhoto={m.dogBridePhoto}
              description={richTextToPlainText(m.description)}
              litterDate={m.litterDate}
              puppies={m.puppies || []}
              gallery={m.gallery || []}
              litterSold={m.litterSold}
              ctaLabel={page?.cardCtaLabel}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
